# LinkedIn Developer Portal application credentials (OAuth2).
# Job search requires Talent Solutions API access; post/content search
# requires Marketing Developer Platform access. Both are granted per-app
# by LinkedIn, not available to a default developer app.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=

# Optional overrides (defaults shown)
# LINKEDIN_API_BASE_URL=https://api.linkedin.com/rest
# LINKEDIN_JOBS_SEARCH_PATH=/simpleJobSearches
# LINKEDIN_POSTS_SEARCH_PATH=/posts

# Filter settings (defaults shown)
# FILTER_MAX_AGE_DAYS=5
# FILTER_MAX_EXPERIENCE_YEARS=8
# FILTER_DIRECT_EMPLOYER_ONLY=true
